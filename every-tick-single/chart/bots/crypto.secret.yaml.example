# crypto.secret.yaml.example — COMMITTED TEMPLATE for the TRADING-BOT Polymarket
# account. Copy to crypto.secret.yaml (gitignored by *.secret.yaml) and fill in.
#
#   cp chart/bots/crypto.secret.yaml.example chart/bots/crypto.secret.yaml
#
# ACCOUNT SPLIT (2026-07-29):
#   crypto.secret.yaml -> the crypto bots (5m vacuum, and later 15m/1h). Used by
#                       winner-vacuum, crash-catcher, settlement-sniper, nextrev.
#   scout.secret.yaml   -> the pm-scout / world-bets account. Used by
#                       pm-scout/tools/wallet.py. LEAVE IT ALONE when rotating
#                       the bot key, or both sides move at once.
#
# API credentials are NOT stored here: the client derives them from the private
# key at startup (create_or_derive_api_key), so a new key yields new API creds
# automatically.
#
# Check which wallet a given overlay points at:
#   PM_SECRET_YAML=chart/bots/crypto.secret.yaml bash tools/balance.sh

credentials:
  polymarketPrivateKey: "0x<signer EOA private key>"
  polymarketAddress:    "0x<signer EOA address>"
  # 0 = bare EOA (self-funded, needs POL for gas)
  # 2 = Polymarket proxy/Safe (gasless; funder is the Safe holding the USDC)
  polymarketSignatureType: "2"
  polymarketFunder:     "0x<Safe address holding the funds>"

bot:
  paperMode:    "false"
  dryRun:       "false"
  liveTrading:  "true"
