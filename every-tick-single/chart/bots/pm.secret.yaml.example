# pm.secret.yaml.example (Polymarket credentials, shared by ALL bots/coins) — COMMITTED TEMPLATE. Copy to pm.secret.yaml (gitignored)
# and fill in the real values. This overlay holds live credentials + the live-trading
# flags, so the committed sol_single.yaml stays paper.
#
#   cp chart/bots/pm.secret.yaml.example chart/bots/pm.secret.yaml
#   # edit chart/bots/pm.secret.yaml with real values (never commit it)
#
# Deploy LIVE:
#   cd every-tick-single && source ../.dev-env-source
#   helm upgrade --install sol-every-tick-single ./chart \
#     -f chart/bots/sol_single.yaml -f chart/bots/pm.secret.yaml -n every-tick-single
#
# Revert to paper: ./deploy.sh sol   (redeploys without the secret overlay)

credentials:
  polymarketPrivateKey: "0xYOUR_WALLET_PRIVATE_KEY"   # REQUIRED (wallet/owner EOA key)
  polymarketAddress: "0xYOUR_PROXY_OR_EOA_ADDRESS"    # REQUIRED
  # CLOB API creds are OPTIONAL — leave blank and the bot auto-derives them from
  # the private key (create_or_derive_api_key). Only set them to pin a known key.
  polymarketApiKey: ""           # optional (auto-derived if blank)
  polymarketApiSecret: ""        # optional
  polymarketApiPassphrase: ""    # optional
  polymarketSignatureType: "0"   # 0=EOA, 1=email/magic proxy, 2=Gnosis Safe
  polymarketFunder: ""           # funder/Safe address; blank for EOA (type 0)

bot:
  # ── live gates — the bot hard-errors unless ALL of these align ─────────────
  liveTrading: "true"
  paperMode: "false"
  dryRun: "false"
  # ── hard safety caps ───────────────────────────────────────────────────────
  liveMaxOrderUsd: "5"          # per-order notional ceiling
  liveMaxDailyLossUsd: "25"     # daily realized loss → cancel all + halt for the UTC day
  quoteNotionalUsd: "5"
  liveQuoteWarmupSecs: "0"
  prediscoveryLeadSecs: "30"
  liveReconcileSecs: "30"
  # ── Relayer (gasless on-chain redemptions; only for signatureType 2 / Safe) ──
  # Separate from the CLOB API creds above. Key is from Polymarket's
  # "Relayer API keys" page. Optional — without it, redemptions self-broadcast
  # via RPC and need MATIC for gas.
  polymarketUseRelayer: "false"          # set "true" to route Safe redemptions gaslessly
  polymarketRelayerApiKey: ""            # RELAYER_API_KEY (e.g. 019f439e-…)
  polymarketRelayerApiKeyAddress: ""     # RELAYER_API_KEY_ADDRESS (signer addr)
