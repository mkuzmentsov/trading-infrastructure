# openmm.secret.yaml.example — TEMPLATE for the 5m maker (openmm) pilot.
#
# HOW TO USE
#   cp chart/bots/openmm.secret.yaml.example chart/bots/openmm.secret.yaml
#   ...fill the four credential values...  then tell Claude it is ready.
# The real file matches .gitignore `*.secret.*` so it is NEVER committed.
# Verify before you paste anything:
#   git check-ignore -v chart/bots/openmm.secret.yaml     # must print a match
#
# ─────────────────────────────────────────────────────────────────────────────
# WHICH ADDRESS GOES WHERE  (this trips everyone up — see docs/README infra note
# "orders need the PROXY as funder/maker, not the signer EOA")
#
#   polymarketPrivateKey  the SIGNER's private key. Signs orders. Holds nothing.
#   polymarketAddress     the signer EOA address (must derive from the key above)
#   polymarketFunder      the address that actually HOLDS the USDC and is booked
#                         as the maker/taker on every fill
#   polymarketSignatureType
#                         0 = EOA-direct  -> funder == the signer EOA itself,
#                                            USDC must sit at that EOA on Polygon
#                         1 = email/magic proxy
#                         2 = Gnosis Safe -> funder is the SAFE that Polymarket
#                                            created on your first UI deposit.
#                                            Find it in the PM UI under Deposit /
#                                            your profile address. NOT your
#                                            MetaMask address.
#
# For reference, the existing vacmaker fleet (chart/bots/crypto.secret.yaml) is:
#   signer EOA  0x7BbDaf4A6CADD824F14129ec5F6038d1559D3AD3   (key derives to this)
#   funder Safe 0xdb66d8967c58d9014b8b57fed77e45f377ea24d9   (holds the money)
#   sigType     2
# Keep this pilot on a DIFFERENT funder so its PnL and maker rebates are cleanly
# separable from vacmaker's, and so a bug here cannot drain the working fleet.
#
# FUNDING: the pilot needs USDC at the FUNDER address (not the signer).
# Pilot size is `orderMinSize`=5 shares (~$2.50/order) — $20-40 is plenty.
# ─────────────────────────────────────────────────────────────────────────────

credentials:
  polymarketPrivateKey: ""      # 0x… private key of the SIGNER  (REQUIRED)
  polymarketAddress: ""         # 0x… signer EOA                  (REQUIRED)
  polymarketFunder: ""          # 0x… address holding the USDC    (REQUIRED)
  polymarketSignatureType: "2"  # 0=EOA, 1=email/magic, 2=Gnosis Safe

bot:
  # ── live gates — the bot hard-errors unless ALL of these align ─────────────
  liveTrading: "true"
  paperMode: "false"
  dryRun: "false"
  # ── hard safety caps (pilot sizing — see docs/strat-openmm-5m.md §11e) ─────
  # The strategy is UNPROVEN: sim says +$151/day at size 50 across 6 coins with
  # t=+3.25, but its neighbours run t=1.5-1.9 and ~85% of PnL is a directional
  # residual with ~$200/day std. This pilot is an INFORMATION-GATHERING run to
  # measure real fill rates, queue behaviour and rebate credit — not a profit
  # expectation. Expected PnL ≈ 0 ± noise. Scale only after live data.
  quoteNotionalUsd: "2.5"       # 5 shares @ ~0.50 = the venue orderMinSize
  liveMaxOrderUsd: "3"          # per-order notional ceiling
  liveMaxDailyLossUsd: "10"     # realized daily loss → cancel all + halt for the UTC day
  liveQuoteWarmupSecs: "0"
  liveReconcileSecs: "30"
