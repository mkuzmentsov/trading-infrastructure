# Each exchange block is optional. Leave keys blank to skip registering that
# exchange's tools — the server will still start with whatever is configured.

# ---- Binance ----------------------------------------------------------------
# https://www.binance.com/en/my/settings/api-management
# Permissions: Read (always), + Spot/Margin Trading, + Futures, + Withdrawals
# as needed. IP-whitelist the key to your machine's egress IP.
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Optional: route to Binance testnet
BINANCE_TESTNET=false

# ---- Kraken spot ------------------------------------------------------------
# https://www.kraken.com/u/security/api
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# ---- Kraken Futures ---------------------------------------------------------
# SEPARATE keys from spot: https://futures.kraken.com → Settings → API Keys.
# Enables the kraken_futures_* perp tools + Kraken in compare_perp_funding.
KRAKEN_FUTURES_API_KEY=
KRAKEN_FUTURES_API_SECRET=

# ---- Hyperliquid ------------------------------------------------------------
# ACCOUNT_ADDRESS is the MASTER 0x… address — the one that approved the API
# wallet at https://app.hyperliquid.xyz/API. Always set this to the master,
# even if you want to operate on a sub.
HYPERLIQUID_ACCOUNT_ADDRESS=
# API wallet (agent) private key. Approved on the master above.
HYPERLIQUID_API_PRIVATE_KEY=
# OPTIONAL: route reads + trades to a sub-account / vault owned by the master.
# When set, the master's agent signs and HL executes on this address. Leave
# empty to operate directly on the master.
HYPERLIQUID_VAULT_ADDRESS=
# Optional: route to HL testnet
HYPERLIQUID_TESTNET=false

# ---- WhiteBIT ---------------------------------------------------------------
# https://whitebit.com/api-keys
WHITEBIT_API_KEY=
WHITEBIT_API_SECRET=

# ---- Bybit ------------------------------------------------------------------
# https://www.bybit.com/app/user/api-management  (Unified Trading Account)
BYBIT_API_KEY=
BYBIT_API_SECRET=

# ---- MEXC -------------------------------------------------------------------
# https://www.mexc.com/user/openapi  (spot trade + read; futures API is read-only)
MEXC_API_KEY=
MEXC_API_SECRET=

# ---- Bitget -----------------------------------------------------------------
# https://www.bitget.com/account/newapi  (needs a PASSPHRASE — a 3rd credential)
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_API_PASSPHRASE=

