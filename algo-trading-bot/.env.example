# Copy to .env and fill in. Used ONLY by the guarded real-money `live` mode.
# Paper mode (the default) ignores these — it simulates fills and needs no keys.
# .env is gitignored; never commit real secrets.

# Kraken Futures (perps) — what the bot trades. Separate from spot keys.
ATB_KRAKENFUTURES_API_KEY=
ATB_KRAKENFUTURES_API_SECRET=

# Hyperliquid (perps) — API wallet address + its private key
ATB_HL_WALLET_ADDRESS=
ATB_HL_PRIVATE_KEY=

# Kraken spot (optional; only if you trade the spot venue)
ATB_KRAKEN_API_KEY=
ATB_KRAKEN_API_SECRET=
