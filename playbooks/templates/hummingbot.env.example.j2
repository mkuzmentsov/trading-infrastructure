# Copy this file to .env and fill in all values before running the playbook again.

# Image references
HUMMINGBOT_IMAGE=ghcr.io/hummingbot/hummingbot:latest
HUMMINGBOT_API_IMAGE=ghcr.io/hummingbot/hummingbot-api:latest

# Common
TZ=UTC

# API
HUMMINGBOT_API_PORT=8000

# PostgreSQL
POSTGRES_DB=hummingbot
POSTGRES_USER=hummingbot
POSTGRES_PASSWORD=change_me_strong_password

# Redis
REDIS_PASSWORD=change_me_redis_password
