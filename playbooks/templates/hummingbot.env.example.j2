# Copy this file to .env and fill in all values before running the playbook again.

# Image references
HUMMINGBOT_IMAGE=ghcr.io/hummingbot/hummingbot:latest
HUMMINGBOT_API_IMAGE=ghcr.io/hummingbot/hummingbot-api:latest
HUMMINGBOT_GATEWAY_IMAGE=hummingbot/gateway:latest

# Common
TZ=UTC

# API
HUMMINGBOT_API_PORT=8000

# Gateway
HUMMINGBOT_GATEWAY_PORT=15888
HUMMINGBOT_GATEWAY_PASSPHRASE=change_me_gateway_passphrase

# MQTT Broker (EMQX)
BROKER_HOST=emqx
BROKER_PORT=1883

# PostgreSQL
POSTGRES_DB=hummingbot
POSTGRES_USER=hummingbot
POSTGRES_PASSWORD=change_me_strong_password
DATABASE_URL=postgresql+asyncpg://hummingbot:change_me_strong_password@postgres:5432/hummingbot

# Redis
REDIS_PASSWORD=change_me_redis_password
