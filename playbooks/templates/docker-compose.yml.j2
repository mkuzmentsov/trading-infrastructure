services:
  hummingbot:
    image: ${HUMMINGBOT_IMAGE}
    container_name: hummingbot
    restart: unless-stopped
    env_file:
      - .env
    environment:
      TZ: ${TZ:-UTC}
    volumes:
      - ./bot/conf:/home/hummingbot/conf
      - ./bot/data:/home/hummingbot/data
      - ./bot/logs:/home/hummingbot/logs
    depends_on:
      emqx:
        condition: service_healthy
      redis:
        condition: service_healthy
      gateway:
        condition: service_started

  hummingbot-api:
    image: ${HUMMINGBOT_API_IMAGE}
    container_name: hummingbot-api
    restart: unless-stopped
    env_file:
      - .env
    environment:
      TZ: ${TZ:-UTC}
      DATABASE_URL: ${DATABASE_URL}
      BROKER_HOST: ${BROKER_HOST}
      BROKER_PORT: ${BROKER_PORT}
      REDIS_HOST: redis
      REDIS_PORT: 6379
      REDIS_PASSWORD: ${REDIS_PASSWORD}
      DB_HOST: postgres
      DB_PORT: 5432
      DB_NAME: ${POSTGRES_DB}
      DB_USER: ${POSTGRES_USER}
      DB_PASSWORD: ${POSTGRES_PASSWORD}
    depends_on:
      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy
      emqx:
        condition: service_healthy
    ports:
      - "${HUMMINGBOT_API_PORT:-8000}:8000"
    volumes:
      - ./api/conf:/home/hummingbot-api/conf
      - ./api/logs:/home/hummingbot-api/logs
      - /var/run/docker.sock:/var/run/docker.sock

  gateway:
    image: ${HUMMINGBOT_GATEWAY_IMAGE}
    container_name: hummingbot-gateway
    restart: unless-stopped
    env_file:
      - .env
    environment:
      TZ: ${TZ:-UTC}
      GATEWAY_PASSPHRASE: ${HUMMINGBOT_GATEWAY_PASSPHRASE}
    ports:
      - "${HUMMINGBOT_GATEWAY_PORT:-15888}:15888"
    volumes:
      - ./gateway/conf:/home/gateway/conf
      - ./gateway/certs:/home/gateway/certs
      - ./gateway/logs:/home/gateway/logs

  emqx:
    image: emqx:5
    container_name: hummingbot-broker
    restart: unless-stopped
    environment:
      EMQX_NAME: emqx
    ports:
      - "${BROKER_PORT:-1883}:1883"
      - "18083:18083"
    volumes:
      - emqx-data:/opt/emqx/data
      - emqx-log:/opt/emqx/log
      - emqx-etc:/opt/emqx/etc
    healthcheck:
      test: ["CMD-SHELL", "emqx ctl status >/dev/null 2>&1"]
      interval: 5s
      timeout: 25s
      retries: 10

  postgres:
    image: postgres:16
    container_name: hummingbot-postgres
    restart: unless-stopped
    env_file:
      - .env
    environment:
      POSTGRES_DB: ${POSTGRES_DB}
      POSTGRES_USER: ${POSTGRES_USER}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
    volumes:
      - ./postgres/data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER} -d ${POSTGRES_DB}"]
      interval: 10s
      timeout: 5s
      retries: 10

  redis:
    image: redis:7-alpine
    container_name: hummingbot-redis
    restart: unless-stopped
    command: ["sh", "-c", "redis-server --appendonly yes --requirepass \"$${REDIS_PASSWORD}\""]
    env_file:
      - .env
    volumes:
      - ./redis/data:/data
    healthcheck:
      test: ["CMD-SHELL", "redis-cli -a \"$${REDIS_PASSWORD}\" ping | grep PONG"]
      interval: 10s
      timeout: 5s
      retries: 10

volumes:
  emqx-data: {}
  emqx-log: {}
  emqx-etc: {}
