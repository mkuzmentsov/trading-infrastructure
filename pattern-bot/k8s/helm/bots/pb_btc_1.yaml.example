# BTC 1h pattern bot — live execution test.
#
# 1. Copy:       cp pb_btc_1.yaml.example pb_btc_1.yaml   (gitignored)
# 2. Fill creds: hyperliquid.account_address + secret_key (use an HL API wallet,
#                NOT your main key), and telegram.{bot_token,chat_id} if you want alerts
# 3. Fund:       USDC on the HL account/subaccount you point at
# 4. Deploy DRY: ../deploy.sh pb_btc_1        (dry_run: true below)
# 5. Watch:      kubectl logs -f deploy/pb-btc-1 -n pattern-bot
#                STATE lines should show real mark prices; you should get the
#                "🤖 pattern-bot started" Telegram message immediately.
# 6. Go live:    set dry_run: false here, re-run ../deploy.sh pb_btc_1
#                (the checksum/secret annotation re-rolls the pod).
#
# Only the keys below override the chart defaults in values.yaml (deep-merged),
# so you usually only need credentials + dry_run here.

botConfig:
  dry_run: true            # flip to false only after the dry-run STATE logs look right
  coins: [BTC]

  telegram:
    enabled: true
    bot_token: "YOUR_TELEGRAM_BOT_TOKEN"   # from @BotFather
    chat_id:   "YOUR_TELEGRAM_CHAT_ID"     # from @userinfobot

  hyperliquid:
    base_url: "https://api.hyperliquid.xyz"
    # QUOTE these. Use an HL API wallet (app.hyperliquid.xyz → API), not your main key.
    account_address: "0xYOUR_HL_ACCOUNT_OR_SUBACCOUNT_ADDRESS"
    vault_address:   ""    # set to a subaccount address if trading a sub; else blank
    secret_key:      "0xYOUR_HL_API_WALLET_PRIVATE_KEY"

persistence:
  enabled: true
  size: 100Mi
