services:
  freqtrade:
    image: "{{ freqtrade_image | default('freqtradeorg/freqtrade:stable') }}"
    container_name: freqtrade
    restart: unless-stopped
    environment:
      # Force recreation when config changes
      CONFIG_HASH: "{{ lookup('template', 'config.json.j2') | hash('sha256') }}"
      STRATEGY_HASH: "{{ lookup('template', 'SampleStrategy.py.j2') | hash('sha256') }}"
    volumes:
      - "./user_data:/freqtrade/user_data"
    # Expose the UI port
    ports:
      - "{{ freqtrade_ui_port | default('8080') }}:8080"
    command: >
      trade
      --db-url sqlite:///user_data/tradesv3.sqlite
      --config /freqtrade/user_data/config.json
      --strategy {{ freqtrade_strategy | default('SampleStrategy') }}

  frequi:
    image: "{{ frequi_image | default('freqtradeorg/frequi:latest') }}"
    container_name: frequi
    restart: unless-stopped
    ports:
      - "{{ frequi_port | default('3000') }}:80"
